# Environment Variables for Appointment Board

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_board?schema=public"

# If DATABASE_URL is left empty or not provided, the application runs in zero-config
# local mode with persistence in .data/appointments.json so reviewers can test immediately.
